# Copy this file to .env and change the values. Never commit .env.
APP_ENV=development
POSTGRES_USER=dhai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dhai
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_MINUTES=30

# Text messages
#   outbox = TEST MODE: texts appear in the app's "Texts" tab (fake phone). Free.
#   twilio = real texts (fill in the 3 TWILIO_ values). Costs money per text.
SMS_PROVIDER=outbox
SMS_APP_NUMBER=+15550001000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# How often (seconds) the app checks for reminders to send
REMINDER_TICK_SECONDS=30
